<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="LoKeyTyper.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Microsoft.UI.Xaml.Controls"
    Title="LoKey Typer">

    <Grid x:Name="RootGrid" Background="#09090b">
        <!-- WebView2 — loads bundled web content -->
        <controls:WebView2 x:Name="AppWebView"
                           DefaultBackgroundColor="#09090b"/>

        <!-- Native splash overlay — later sibling, so it paints on top until collapsed -->
        <Grid x:Name="SplashOverlay" Background="#09090b">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="16">
                <TextBlock Text="LoKey Typer"
                           FontSize="28" FontWeight="SemiBold"
                           Foreground="#fafafa"
                           HorizontalAlignment="Center"/>
                <TextBlock x:Name="SplashSubtitle"
                           Text="Speed · Accuracy · Consistency"
                           FontSize="14"
                           Foreground="#a1a1aa"
                           TextWrapping="Wrap"
                           MaxWidth="420"
                           TextAlignment="Center"
                           HorizontalAlignment="Center"/>
                <TextBlock x:Name="SplashDetail"
                           Text=""
                           FontSize="12"
                           Foreground="#71717a"
                           TextWrapping="Wrap"
                           MaxWidth="420"
                           TextAlignment="Center"
                           HorizontalAlignment="Center"
                           Visibility="Collapsed"/>
                <ProgressRing x:Name="SplashProgress"
                              IsActive="True" Width="32" Height="32"
                              Foreground="#a1a1aa"
                              Margin="0,8,0,0"/>
                <Button x:Name="SplashRetry"
                        Content="Try again"
                        Visibility="Collapsed"
                        Click="OnSplashRetry"
                        HorizontalAlignment="Center"/>
            </StackPanel>
        </Grid>
        <TextBlock x:Name="LinkNotice"
                   Text=""
                   FontSize="14"
                   Foreground="#fafafa"
                   TextWrapping="Wrap"
                   MaxWidth="640"
                   Margin="24"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Bottom"
                   Visibility="Collapsed"/>
    </Grid>
</Window>
